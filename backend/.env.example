APP_NAME=KAIROS
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

SECRET_KEY=YOUR_64_CHARACTER_SECRET
JWT_SECRET_KEY=YOUR_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_EXPIRE_DAYS=7

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=kairos
DATABASE_USER=kairos
DATABASE_PASSWORD=your_password
DATABASE_ECHO=false

REDIS_URL=redis://redis:6379/0

# AI Configuration
AI_ENABLED=true
AI_PROVIDER=groq
AI_DEFAULT_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT=60
AI_MAX_RETRIES=3
AI_STREAMING=true

# Groq API Keys (Add up to 5 keys for rotation)
GROQ_API_KEY_1=your_first_groq_key_here
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Embedding Model
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=nomic-embed-text

# RAG Configuration
RAG_TOP_K=5
RAG_MAX_CHUNKS=8
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Cache
AI_CACHE_ENABLED=true
AI_CACHE_TTL=3600

# Token Limits
AI_MAX_INPUT_TOKENS=16000
AI_MAX_OUTPUT_TOKENS=4096
PROMPT_VERSION=latest

# Background Workers
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Rate Limiting
AI_REQUESTS_PER_MINUTE=60
AI_REQUESTS_PER_HOUR=1000

# Observability
ENABLE_PROMETHEUS=true
ENABLE_TRACING=true
ENABLE_METRICS=true
